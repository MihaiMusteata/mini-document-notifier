<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    
    <appSettings>
        <add key="IntervalSeconds" value="60" />
        <add key="OutputFilePath" value="%ProgramData%\MiniDocumentNotifier\view-configurations.json" />
        <add key="ViewConfigurationSyncServiceUrl" value="http://localhost:62033/ViewConfigurationService.svc" />
    </appSettings>
</configuration>