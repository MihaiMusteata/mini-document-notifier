<?xml version="1.0" encoding="utf-8"?>

<configuration>

    <appSettings>
        <add key="DocumentNotifierServiceUrl"
             value="http://localhost:62033/DocumentNotifierService.svc" />
        <add key="ViewConfigStalenessThresholdHours" value="24" />
        <add key="ViewConfigPath"
             value="C:\Projects\mini-document-notifier\src\MiniDocumentNotifier.BackgroundApp\view-configurations.json" />
    </appSettings>

    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>