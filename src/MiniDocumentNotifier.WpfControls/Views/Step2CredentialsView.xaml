<UserControl x:Class="MiniDocumentNotifier.WpfControls.Views.Step2CredentialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MiniDocumentNotifier.WpfControls.Converters"
             mc:Ignorable="d"
             d:DesignHeight="145" d:DesignWidth="365">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <GroupBox Header="Credentials"
              BorderBrush="#C5C5C5"
              BorderThickness="0.9">

        <StackPanel Margin="40,15,15,0">
            <TextBlock
                Text="Username"
                Margin="0,0,0,4" />
            <TextBox
                Height="20"
                Padding="0,3,0,3"
                Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                Margin="0,0,0,8" />

            <TextBlock
                Text="Password"
                Margin="0,0,0,4" />
            <Grid Margin="0,0,0,4">
                <PasswordBox
                    Height="20"
                    Padding="0,3,0,3"
                    x:Name="PasswordInput"
                    PasswordChanged="PasswordInput_PasswordChanged"
                    Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

                <TextBox
                    Height="20"
                    Padding="0,3,0,3"
                    Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <Button
                Content="{Binding PasswordToggleLabel}"
                Command="{Binding TogglePasswordVisibilityCommand}"
                HorizontalAlignment="Left"
                Padding="8,2" />

        </StackPanel>

    </GroupBox>
</UserControl>